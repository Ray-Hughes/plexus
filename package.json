{
  "name": "plexus",
  "version": "0.3.1",
  "description": "Dual-agent harness: Claude Code + Copilot CLI joined by a shared nervous system",
  "author": {
    "name": "Ray Hughes",
    "email": "raymond.hughes@live.com"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run build:cli && node --test \"test/*.test.mjs\"",
    "test:coverage": "npm run build:cli && node --test --experimental-test-coverage --test-reporter=spec --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='test/**' --test-coverage-exclude='dist/cli/**' test/*.test.mjs",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --mac --win",
    "postinstall": "node scripts/fix-native-permissions.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "node-pty": "^1.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0"
  },
  "homepage": "https://github.com/Ray-Hughes/plexus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ray-Hughes/plexus.git"
  },
  "bugs": {
    "url": "https://github.com/Ray-Hughes/plexus/issues"
  },
  "keywords": [
    "claude-code",
    "copilot-cli",
    "mcp",
    "multi-agent",
    "electron",
    "agent-harness"
  ],
  "engines": {
    "node": ">=20"
  }
}
